-- Synthetic Dropdown Master projection for pre-existing workflow regressions.
-- Included after their access-grant fixtures; no application fallback is created.
insert into crm_private.master_members(jewelos_user_id,tenant_id,snapshot_at)
select jewelos_user_id,'20261008-8888-4000-8000-000000000001',now() from public.crm_sso_access_grants on conflict do nothing;
insert into crm_private.master_options(tenant_id,option_id,master_type,label,value,sort_order,active)
select '20261008-8888-4000-8000-000000000001',gen_random_uuid(),v.kind,v.label,lower(replace(v.label,' ','_')),v.position,true
from (values
('gender','FEMALE',0),('gender','MALE',1),('gender','OTHER',2),('sugar_option','NO SUGAR',0),('sugar_option','LOW SUGAR',1),('sugar_option','Less sugar',2),('beverage','Tea',0),('beverage','Coffee',1),('snack_option','Biscuits',0),('snack_option','Nuts',1),('caste','JAIN',0),('caste','OTHER',1),('gift_option','Backdated Gift',5),('gift_option','Flowers',0),('gift_option','Other:',1),('client_relation','SPOUSE',10),('client_relation','SON',11),('client_relation','FRIEND',12),('client_relation','WIFE',13),('client_relation','Sibling',0),('client_relation','SISTER',1),('client_relation','BROTHER',2),('occupation','Business',0),('occupation','BUSINESS OWNER',1),('occupation','Doctor',2),('communication_preference','CALL',0),('communication_preference','WHATSAPP',1),('bridal_or_non_bridal','BRIDAL',0),('bridal_or_non_bridal','NON BRIDAL',1),('wedding_month','OCTOBER',0),('wedding_month','JANUARY',1),('product_category','Ring',0),('product_category','Chain',1),('product_category','Pendant',2),('product_category','New Ring',3),('product_category','GOLD BRACELET',4),('product_category','gold bracelet',5),('not_bought_reason','Price',0),('not_bought_reason','Other:',1),('crm_source','INSTAGRAM',0),('crm_source','OTHER',1),('potential_category','Cold Lead',0),('potential_category','Cool Lead',1),('potential_category','Warm Lead',2),('potential_category','Hot Lead',3),('potential_category','VIP Lead',4)) v(kind,label,position);
