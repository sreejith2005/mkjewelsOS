+    // JewelOS patch: window.alert / confirm / prompt. The library leaves them to the platform
+    // fallback, which shows a dialog only if it can find an Activity behind the WebView's
+    // context (a React Native view's context is not one); when it cannot, confirm() is false
+    // and prompt() null, and the page's buttons that rely on them do nothing. Shown on the
+    // current Activity instead, so they always appear.
+    @Override
+    public boolean onJsAlert(WebView view, String url, String message, JsResult result) {
+        return showJsDialog(message, null, result, false);
+    }
+
+    @Override
+    public boolean onJsConfirm(WebView view, String url, String message, JsResult result) {
+        return showJsDialog(message, null, result, true);
+    }
+
+    @Override
+    public boolean onJsPrompt(WebView view, String url, String message, String defaultValue, JsPromptResult result) {
+        return showJsDialog(message, defaultValue == null ? "" : defaultValue, result, true);
+    }
+
+    private boolean showJsDialog(String message, String promptDefault, final JsResult result, boolean cancellable) {
+        Activity activity = this.mWebView.getThemedReactContext().getCurrentActivity();
+        if (activity == null || activity.isFinishing()) return false;
+        final EditText input = promptDefault == null ? null : new EditText(activity);
+        AlertDialog.Builder builder = new AlertDialog.Builder(activity)
+            .setMessage(message)
+            .setCancelable(true)
+            .setOnCancelListener(dialog -> result.cancel())
+            .setPositiveButton(android.R.string.ok, (dialog, which) -> {
+                if (input != null) ((JsPromptResult) result).confirm(input.getText().toString());
+                else result.confirm();
+            });
+        if (cancellable) builder.setNegativeButton(android.R.string.cancel, (dialog, which) -> result.cancel());
+        if (input != null) {
+            input.setText(promptDefault);
+            input.setSelection(promptDefault.length());
+            FrameLayout frame = new FrameLayout(activity);
+            int padding = Math.round(20 * activity.getResources().getDisplayMetrics().density);
+            frame.setPadding(padding, 0, padding, 0);
+            frame.addView(input);
+            builder.setView(frame);
+        }
+        builder.show();
+        return true;
+    }
