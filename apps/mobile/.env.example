# Expo inlines only EXPO_PUBLIC_* variables, at build time.
# Change one of these and you must rebuild; a Metro reload will not pick it up.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for a release (scripts/release-mobile.ps1 refuses to build without it): the https
# origin of the JewelOS web app, whose /crm route the CRM tab shows. Origin only, no path.
# The owner fills in the real value; this placeholder is rejected by the release script.
EXPO_PUBLIC_JEWELOS_WEB_ORIGIN=https://<jewelos-web-origin>
