# React Native's Android build compiles third-party C++, and CMake names every
# object file after the full path of its source. pnpm routes those through
# node_modules/.pnpm/<name>@<version>_<32-char hash>/node_modules/, which pushes
# the object path past Windows' 260-character limit and fails the native build.
# npm produces a genuinely flat tree, which is what keeps this app buildable.
#
# The shared @jewelos/* packages are linked from the pnpm workspace by path, so
# their own dependencies still resolve out of the workspace install.
legacy-peer-deps=true
